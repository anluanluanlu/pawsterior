-- allium: 3
-- pawsterior.allium
--
-- Pawsterior: a personal tracker that logs meditation and other
-- self-defined happenings, alongside self-defined observations of mental
-- state, so the person can see how the two move together over time.
--
-- This spec is the primary artefact. The implementation lives in src/
-- (model.js mirrors the entities and rules, insights.js the Insights
-- surface). Keep both aligned when either changes.

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    default_meditation_duration: Duration = 10.minutes
    min_meditation_duration: Duration = 1.minute
    max_meditation_duration: Duration = 4.hours
    min_interval_bell: Duration = 1.minute
    default_warmup: Duration = 15.seconds
    max_warmup: Duration = 5.minutes
    max_type_name_length: Integer = 60
    max_note_length: Integer = 500
    max_rating_name_length: Integer = 30
    max_rating_label_length: Integer = 20
    min_intensity: Integer = 1
    max_intensity: Integer = 5
    future_entry_tolerance: Duration = 1.minute
    insight_lag: Duration = 1.day
    min_days_per_insight_group: Integer = 3
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- What an entry type describes.
--   activity:     something the person did or that happened
--                 (meditation, met friends, drank coffee late)
--   mental_state: an observation of their mental state
--                 (couldn't fall asleep, catastrophic thoughts)
enum EntryKind { activity | mental_state }

-- Whether a mental state suggests good or negative mental health.
enum Polarity { good | negative }

enum AmbientSound { silence | brown_noise | rain | ocean }

------------------------------------------------------------
-- External
------------------------------------------------------------

-- Pawsterior is single-person and local-first: all data stays on the device.
external entity Person {}

-- A backup file produced by Export and read by Import.
external entity Snapshot {}

------------------------------------------------------------
-- Value types
------------------------------------------------------------

-- How a mental state's 1-5 intensity is named and described when it is
-- logged: "Pull" with "Barely" ... "A lot", or "Severity" with numbers only.
-- labels holds one description per step (config.min_intensity to
-- config.max_intensity); a blank description shows the number alone.
value Rating {
    name: String
    labels: List<String>
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity EntryType {
    name: String
    kind: EntryKind
    polarity: Polarity?
    -- The person's own naming of the 1-5 intensity; null means the defaults.
    rating: Rating?
    colour: String
    archived: Boolean
    is_meditation: Boolean

    entries: Entry with type = this

    is_loggable: not archived

    -- What the rating shows: the person's settings, falling back to
    -- "Severity" ("Strength" for good states) with numbers only.
    rating_name: if rating != null and rating.name != "": rating.name
                 else if polarity = good: "Strength"
                 else: "Severity"
    rating_labels: if rating != null: rating.labels else: ["", "", "", "", ""]

    invariant PolarityOnlyForMentalStates {
        (kind = mental_state implies polarity != null)
            and (kind = activity implies polarity = null)
    }

    invariant MeditationIsAnActivity {
        is_meditation implies (kind = activity and not archived)
    }

    invariant RatingOnlyForMentalStates {
        rating != null implies kind = mental_state
    }
}

entity Entry {
    type: EntryType
    occurred_at: Timestamp
    duration: Duration?
    intensity: Integer?
    -- The rating this entry was given under, kept so that later changes to
    -- the type's rating never rewrite how earlier entries were rated.
    scale: Rating?
    note: String?
    session: MeditationSession?

    invariant DurationOnlyForActivities {
        duration != null implies type.kind = activity
    }

    invariant IntensityInRange {
        intensity != null implies
            (intensity >= config.min_intensity and intensity <= config.max_intensity)
    }

    invariant ScaleGoesWithIntensity {
        (scale != null) = (intensity != null)
    }
}

entity MeditationSession {
    planned_duration: Duration
    ambient: AmbientSound
    interval_bell: Duration?
    warmup: Duration
    status: running | paused | completed | discarded
    started_at: Timestamp
    paused_at: Timestamp when status = paused
    paused_total: Duration

    logged_entry: Entry with session = this

    -- Time since starting, excluding pauses; includes the warm-up.
    raw_elapsed: (if status = paused: paused_at else: now) - started_at - paused_total
    -- Time actually spent meditating: the warm-up does not count.
    elapsed: max(raw_elapsed - warmup, 0.seconds)
    remaining: planned_duration - elapsed
    is_due: status = running and elapsed >= planned_duration

    transitions status {
        running -> paused
        paused -> running
        running -> completed
        paused -> completed
        running -> discarded
        paused -> discarded
        terminal: completed, discarded
    }
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

-- Seeded on first launch. Everything except Meditation can be edited,
-- archived or deleted; Meditation can be renamed and recoloured only.

default EntryType meditation = {
    name: "Meditation", kind: activity, polarity: null, rating: null,
    colour: "#7c9cff", archived: false, is_meditation: true
}

default EntryType met_friends = {
    name: "Met friends", kind: activity, polarity: null, rating: null,
    colour: "#5cc8a8", archived: false, is_meditation: false
}

default EntryType could_not_sleep = {
    name: "Couldn't fall asleep", kind: mental_state, polarity: negative, rating: null,
    colour: "#e07a7a", archived: false, is_meditation: false
}

-- Rated by how strongly the thought pulled at the person, not how bad it was.
default EntryType catastrophic_thoughts = {
    name: "Catastrophic thoughts", kind: mental_state, polarity: negative,
    rating: {
        name: "Pull",
        labels: ["Barely", "A little", "Moderate", "Quite a bit", "A lot"]
    },
    colour: "#d9a05b", archived: false, is_meditation: false
}

default EntryType felt_calm = {
    name: "Felt calm", kind: mental_state, polarity: good, rating: null,
    colour: "#8fd16a", archived: false, is_meditation: false
}

------------------------------------------------------------
-- Rules: entry types
------------------------------------------------------------

rule DefineEntryType {
    when: DefineEntryType(name, kind, polarity?, rating?, colour)

    requires: name.length > 0 and name.length <= config.max_type_name_length
    requires: not exists EntryType{name: name}
    requires: kind = mental_state implies polarity != null
    requires: rating = null
        or (rating.name.length <= config.max_rating_name_length
            and rating.labels.all(l => l.length <= config.max_rating_label_length))

    ensures:
        EntryType.created(
            name: name,
            kind: kind,
            polarity: if kind = mental_state: polarity else: null,
            rating: if kind = mental_state: rating else: null,
            colour: colour,
            archived: false,
            is_meditation: false
        )

    @guidance
        -- Name uniqueness is case-insensitive and ignores surrounding whitespace.
}

rule EditEntryType {
    when: EditEntryType(type, name, kind, polarity?, rating?, colour)

    requires: name.length > 0 and name.length <= config.max_type_name_length
    requires: not exists EntryType{name: name} or EntryType{name: name} = type
    -- The kind of a type is fixed once anything has been logged against it,
    -- so history never silently changes meaning.
    requires: kind = type.kind or type.entries.count = 0
    requires: not type.is_meditation or kind = activity
    requires: kind = mental_state implies polarity != null
    requires: rating = null
        or (rating.name.length <= config.max_rating_name_length
            and rating.labels.all(l => l.length <= config.max_rating_label_length))

    ensures:
        type.name = name
        type.kind = kind
        type.polarity = if kind = mental_state: polarity else: null
        -- A blank rating (no name, no descriptions) returns to the defaults.
        type.rating = if kind = mental_state: rating else: null
        type.colour = colour

    @guidance
        -- Changing a rating affects entries logged from now on. Entries
        -- already logged keep the scale they were rated under.
}

rule ArchiveEntryType {
    when: ArchiveEntryType(type)

    requires: not type.archived
    requires: not type.is_meditation

    ensures: type.archived = true

    @guidance
        -- Archived types disappear from quick logging but keep their history
        -- and still take part in insights.
}

rule RestoreEntryType {
    when: RestoreEntryType(type)
    requires: type.archived
    ensures: type.archived = false
}

rule DeleteEntryType {
    when: DeleteEntryType(type)

    requires: not type.is_meditation
    requires: type.entries.count = 0

    ensures: not exists type
}

------------------------------------------------------------
-- Rules: entries
------------------------------------------------------------

rule LogEntry {
    when: LogEntry(type, occurred_at, duration?, intensity?, note?)

    requires: type.is_loggable
    requires: occurred_at <= now + config.future_entry_tolerance
    requires: duration = null or (type.kind = activity and duration > 0.seconds)
    requires: intensity = null
        or (intensity >= config.min_intensity and intensity <= config.max_intensity)
    requires: note = null or length(note) <= config.max_note_length

    ensures:
        Entry.created(
            type: type, occurred_at: occurred_at, duration: duration,
            intensity: intensity, note: note, session: null,
            scale: if intensity != null:
                       Rating{name: type.rating_name, labels: type.rating_labels}
                   else: null
        )
}

rule EditEntry {
    when: EditEntry(entry, occurred_at, duration?, intensity?, note?)

    requires: occurred_at <= now + config.future_entry_tolerance
    requires: duration = null or (entry.type.kind = activity and duration > 0.seconds)
    requires: intensity = null
        or (intensity >= config.min_intensity and intensity <= config.max_intensity)
    requires: note = null or length(note) <= config.max_note_length

    ensures:
        entry.occurred_at = occurred_at
        entry.duration = duration
        entry.intensity = intensity
        entry.note = note
        -- Editing keeps the scale the entry already had. An entry that gains
        -- an intensity for the first time takes its type's current rating.
        entry.scale = if intensity = null: null
                      else if entry.scale != null: entry.scale
                      else: Rating{name: entry.type.rating_name, labels: entry.type.rating_labels}
}

rule DeleteEntry {
    when: DeleteEntry(entry)
    ensures:
        not exists entry
        -- A session's entry is its only trace, so deleting the entry
        -- deletes the session too and CompletedSessionsAreLogged holds.
        if entry.session != null: not exists entry.session
}

------------------------------------------------------------
-- Rules: meditation sessions
------------------------------------------------------------

rule StartMeditation {
    when: StartMeditation(planned_duration, ambient, interval_bell?, warmup)

    requires: not exists MeditationSession{status: running}
    requires: not exists MeditationSession{status: paused}
    requires: planned_duration >= config.min_meditation_duration
    requires: planned_duration <= config.max_meditation_duration
    requires: interval_bell = null
        or (interval_bell >= config.min_interval_bell and interval_bell < planned_duration)
    requires: warmup >= 0.seconds and warmup <= config.max_warmup

    ensures:
        MeditationSession.created(
            planned_duration: planned_duration,
            ambient: ambient,
            interval_bell: interval_bell,
            warmup: warmup,
            status: running,
            started_at: now,
            paused_total: 0.seconds
        )

    @guidance
        -- The warm-up comes before the timed meditation (default
        -- config.default_warmup, adjustable, 0 for none). Play a short wood
        -- snap when it ends; with no warm-up, ring the bowl at the start
        -- instead. The warm-up is not logged. Play the ambient sound while running.
        -- Ring a soft bell every interval_bell of elapsed time, and a deep
        -- bell at the end. Schedule bells on the audio clock so they stay
        -- on time when the page is in the background, and keep the screen
        -- awake while a session runs where the platform allows.
}

rule PauseMeditation {
    when: PauseMeditation(session)
    requires: session.status = running
    ensures:
        session.status = paused
        session.paused_at = now
    @guidance
        -- Fade the ambient sound out and cancel scheduled bells.
}

rule ResumeMeditation {
    when: ResumeMeditation(session)
    requires: session.status = paused
    ensures:
        session.paused_total = session.paused_total + (now - session.paused_at)
        session.status = running
        session.paused_at = null
}

rule MeditationTimeIsUp {
    when: session: MeditationSession.is_due
    requires: session.status = running
    ensures: SessionEnded(session: session)
}

rule FinishMeditationEarly {
    when: FinishMeditationEarly(session)
    requires: session.status = running or session.status = paused
    requires: session.elapsed >= config.min_meditation_duration
    ensures: SessionEnded(session: session)
    @guidance
        -- If less than the minimum has elapsed, offer to discard instead.
}

rule LogFinishedMeditation {
    when: SessionEnded(session)
    requires: session.status = running or session.status = paused

    let meditation = EntryType{is_meditation: true}

    ensures:
        Entry.created(
            type: meditation,
            occurred_at: session.started_at,
            duration: if session.elapsed > session.planned_duration:
                          session.planned_duration
                      else: session.elapsed,
            intensity: null,
            scale: null,
            note: null,
            session: session
        )
        session.status = completed
        session.paused_at = null
}

rule DiscardMeditation {
    when: DiscardMeditation(session)
    requires: session.status = running or session.status = paused
    ensures:
        session.status = discarded
        session.paused_at = null
    @guidance
        -- A discarded session leaves no entry behind.
}

------------------------------------------------------------
-- Rules: data portability
------------------------------------------------------------

rule ImportData {
    when: ImportData(snapshot)
    requires: Snapshot.is_valid(snapshot)
    ensures: Snapshot.replace_all(snapshot)
    @guidance
        -- Import replaces everything after an explicit confirmation.
        -- Export is a read-only JSON download of every type, entry and setting.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ExactlyOneMeditationType {
    (EntryTypes where is_meditation).count = 1
}

invariant AtMostOneActiveSession {
    (MeditationSessions where status in {running, paused}).count <= 1
}

invariant CompletedSessionsAreLogged {
    for s in MeditationSessions:
        s.status = completed implies exists s.logged_entry
}

invariant DiscardedSessionsLeaveNoEntry {
    for s in MeditationSessions:
        s.status = discarded implies not exists s.logged_entry
}

------------------------------------------------------------
-- Actors and Surfaces
------------------------------------------------------------

actor Owner {
    identified_by: Person
}

surface Meditate {
    facing _: Owner

    exposes:
        config.default_meditation_duration
        for session in MeditationSessions where status in {running, paused}:
            session.remaining
            session.status

    provides:
        StartMeditation(planned_duration, ambient, interval_bell, warmup)
        for session in MeditationSessions where status in {running, paused}:
            PauseMeditation(session)
            ResumeMeditation(session)
            FinishMeditationEarly(session)
            DiscardMeditation(session)

    @guarantee SurvivesReload
        -- A running or paused session is persisted and resumes after reload.

    @guidance
        -- Show remaining time large and calm. After a session ends, invite
        -- the person to log how they feel.
}

surface Log {
    facing _: Owner

    exposes:
        EntryTypes where is_loggable

    provides:
        for type in EntryTypes where is_loggable:
            LogEntry(type, occurred_at, duration, intensity, note)
        DefineEntryType(name, kind, polarity, rating, colour)

    @guidance
        -- Logging should be one tap plus an optional detail sheet.
        -- Group activities and mental states; tint good and negative states apart.
}

surface History {
    facing _: Owner

    exposes:
        Entries

    provides:
        for entry in Entries:
            EditEntry(entry, occurred_at, duration, intensity, note)
            DeleteEntry(entry)
}

surface ManageTypes {
    facing _: Owner

    exposes:
        EntryTypes

    provides:
        for type in EntryTypes:
            EditEntryType(type, name, kind, polarity, rating, colour)
            ArchiveEntryType(type)
            RestoreEntryType(type)
            DeleteEntryType(type)
        ImportData(snapshot)
}

surface Insights {
    facing _: Owner

    exposes:
        Entries
        EntryTypes

    @guidance
        -- Work in local calendar days, from the first logged day to today.
        -- For every pair (activity A, mental state S): a day is "with A" when
        -- A was logged that day or within config.insight_lag before it.
        -- Report the share of days-with-A on which S was logged against the
        -- share of the other days on which S was logged. Hide pairs where
        -- either group has fewer than config.min_days_per_insight_group days.
        -- Rank by the size of the difference. A difference is favourable
        -- when a good state is more common, or a negative state less common, with A.
        -- Always state that this shows association, not cause.
        -- Intensity is descriptive only: it never weights insights, which
        -- count presence or absence per day.
}

------------------------------------------------------------
-- Deferred and Open Questions
------------------------------------------------------------

deferred Snapshot.is_valid       -- see: src/model.js importState
deferred Snapshot.replace_all    -- see: src/model.js importState

-- Decided 2026-11-13: intensity stays descriptive only (see Insights).
-- Decided 2026-11-27: every mental state names its own 1-5 rating and may
-- describe its steps (the type's `rating`). Without settings it is
-- "Severity" ("Strength" for good states), numbers only. Each rated entry
-- keeps the scale it was logged under (`scale`), so changing a rating never
-- rewrites history. "Catastrophic thoughts" ships as "Pull" because naming the
-- thought's severity risks making it feel more significant.
-- Decided 2026-11-13: no sync; data stays on one device, and Export/Import
-- is the only way to move it.
-- Decided 2026-11-14: no reminders; Pawsterior never prompts the person to
-- meditate or log. Logging is always self-initiated.
